From d2b68110538f4e8a591a7cc7e982bb7214d9178b Mon Sep 17 00:00:00 2001
From: Romain Dolbeau <romain@dolbeau.org>
Date: Sun, 9 Aug 2026 08:36:04 +0200
Subject: [PATCH 4/5] hw/scsi: add the Sun-3 "si" onboard SCSI board

The 3/60's SCSI is three things in one 32-byte register block: an NCR
5380, an AMD Am9516 Universal DMA Controller, and Sun's own byte/word
packing FIFO between them.  This models the second and third and embeds
the first, so there is no SCSI protocol in this file at all - what it
knows about the chip is DRQ, DACK, End of Process and the phase.

The board is not pseudo-DMA, a claim worth contradicting because it is
widely repeated.  The Am9516 is a real bus master: the driver builds a
six-word chain table in DVMA memory, hands the UDC only the address of
it, and says "start chaining"; the UDC fetches its own channel setup
from that table and then moves the data through the machine's DVMA
IOMMU.  Both the Sun-3 Architecture Manual and every driver that has
ever driven this board work that way.

Only the corner of the Am9516 that Sun uses is modelled: channel 1,
word transfers, a one-shot chain of three register groups.  A model of
the rest would be a model of code nobody runs.

The VME-only registers are accepted and ignored rather than left
unmapped.  One driver serves both boards and writes them
unconditionally, and the 3/60 PROM is one of them - it puts
VME_SUPV_DATA_24 in si_iv_am before it does anything else.  On this
machine an unmapped access is a real bus error, so a model that stopped
at si_csr would fail the PROM's probe outright and report itself as no
controller at all.

Three status bits took a driver to settle, and all three are about
transfers that do not end the tidy way.  DMA_CONFLICT reports a real
bus collision, and arming the UDC before programming the 5380 is the
normal order, so a model that flagged every access during a transfer
would condemn the drivers that exist.  DMA_IP is not raised at terminal
count: both NetBSD and SunOS arm the UDC's channel interrupt before
every transfer, but SunOS's siintr tests DMA_IP before anything else
and treats it as an error - "dma ip, unknown reason" - so hardware that
raised it on a normal completion would have failed every transfer SunOS
ever made.

DMA_ACTIVE is the third and it cost a boot.  A transfer ends when the
chip stops asking, not only when the byte count reaches zero: SunOS
asks a disk for 56 bytes of INQUIRY, a SCSI-1 disk answers with the
standard 36 and goes to STATUS, and the UDC stops there with twenty
bytes still on its count.  si_cmdwait polls the CSR for DMA_ACTIVE to
clear and gives up with "DMA_ACTIVE still on", which is what a model
that held the bit until terminal count produced - for ever.  NetBSD
asks for exactly what it will get, so it never saw it.

Knowing *when* the chip has stopped asking took three tries, and the
two wrong answers are worth stating because each looks right alone:

  * the chip's interrupt is a latch.  It stays asserted until the
    driver reads register 7, so one left over from the command before
    is asserted at the instant the next transfer starts, and a pump
    that ended on it would abort transfers that had not begun.

  * the phase match is momentary.  It is false in the window between
    arming the UDC and writing the Target Command Register - every
    driver here arms first - which wedges the PROM on its first read,
    and it flickers during a transfer, which ended the PROM's boot
    block read early and got "scsi: dma never completed".

So both, and only after the chip has asked at least once: a transfer
that has started, whose phase has gone, and whose chip has interrupted,
is a transfer whose target has moved on.

The pump moves bytes and then returns rather than waiting for the next
one, and both of the chip's pins bring it back.  DRQ is the ordinary
case; the interrupt is how a *short* transfer ends, because when the
target gives less than was asked for the chip stops asking and never
raises DRQ again, so DRQ cannot be what notices.  Returning is not an
optimisation but a requirement: scsi_req_enqueue on a real disk
completes on QEMU's AIO path, which cannot run while this function
holds the thread inside an MMIO handler, so a pump that waited for the
byte it is waiting for would wait for ever.  It is the same shape as
esp.c's dma_cb.

Signed-off-by: Romain Dolbeau <romain@dolbeau.org>
---
 hw/scsi/Kconfig      |   7 +
 hw/scsi/meson.build  |   1 +
 hw/scsi/sun3-si.c    | 749 +++++++++++++++++++++++++++++++++++++++++++
 hw/scsi/trace-events |   8 +
 4 files changed, 765 insertions(+)
 create mode 100644 hw/scsi/sun3-si.c

diff --git a/hw/scsi/Kconfig b/hw/scsi/Kconfig
index 67ba701bb3..25f93f76a5 100644
--- a/hw/scsi/Kconfig
+++ b/hw/scsi/Kconfig
@@ -70,6 +70,13 @@ config VHOST_USER_SCSI
     select VHOST_SCSI_COMMON
     depends on VIRTIO && VHOST_USER && LINUX
 
+config SUN3_SI
+    bool
+    select NCR5380
+    # The Sun-3 board's own logic - an Am9516 UDC and a packing FIFO - around
+    # a 5380.  It is a SysBus device on an onboard machine and is never
+    # user-created, so it has no default here: the machine selects it.
+
 config NCR5380_ISA
     bool
     default y
diff --git a/hw/scsi/meson.build b/hw/scsi/meson.build
index 41ed4a4620..7bd218e3b5 100644
--- a/hw/scsi/meson.build
+++ b/hw/scsi/meson.build
@@ -28,6 +28,7 @@ scsi_ss.add_all(when: 'CONFIG_VIRTIO_SCSI', if_true: virtio_scsi_ss)
 
 specific_scsi_ss.add(when: 'CONFIG_SPAPR_VSCSI', if_true: files('spapr_vscsi.c'))
 
+system_ss.add(when: 'CONFIG_SUN3_SI', if_true: files('sun3-si.c'))
 system_ss.add(when: 'CONFIG_NCR5380_ISA', if_true: files('ncr5380-isa.c'))
 
 system_ss.add_all(when: 'CONFIG_SCSI', if_true: scsi_ss)
diff --git a/hw/scsi/sun3-si.c b/hw/scsi/sun3-si.c
new file mode 100644
index 0000000000..8e29c67f52
--- /dev/null
+++ b/hw/scsi/sun3-si.c
@@ -0,0 +1,749 @@
+/*
+ * Sun-3 "si" SCSI interface, onboard (OBIO) flavour - 3/50 and 3/60.
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * The board is three things in one 32-byte register block: an NCR 5380, an
+ * AMD Am9516 Universal DMA Controller, and Sun's own byte/word packing FIFO
+ * between them.  Only the FIFO and the UDC are modelled here; the chip is
+ * hw/scsi/ncr5380.c, embedded as a child device, so this file contains no
+ * SCSI protocol at all.
+ *
+ * The layout is NetBSD's sys/arch/sun3/dev/sireg.h:
+ *
+ *   0x00-0x07  the NCR 5380, one byte apart
+ *   0x08-0x0e  dma_addrh/l, dma_counth/l   VME only
+ *   0x10       udc_data     Am9516 data port
+ *   0x12       udc_addr     Am9516 register pointer
+ *   0x14       fifo_data    read-only; the leftover byte of an odd transfer
+ *   0x16       fifo_count   bytes; reads back as the residual
+ *   0x18       si_csr       control and status
+ *   0x1a-0x20  si_bprh/l, si_iv_am, fifo_cnt_hi   VME only
+ *
+ * The VME-only registers are not decoration.  One driver serves both boards
+ * and writes them unconditionally, and the 3/60 PROM is one of them: it puts
+ * VME_SUPV_DATA_24 in si_iv_am before it does anything else.  On this machine
+ * an unmapped access is a real bus error, so a model that stopped at si_csr
+ * would fail the PROM's probe outright and report itself as no controller at
+ * all.  They are accepted and ignored here, which is what the onboard board
+ * does with them.
+ *
+ * The 3/60's SCSI is *not* pseudo-DMA - a claim worth contradicting because
+ * it is widely repeated.  The Am9516 is a real bus master: the driver builds
+ * a six-word chain table in DVMA memory, hands the UDC only the address of
+ * it, and says "start chaining"; the UDC fetches its own channel setup from
+ * that table and then moves the data.  Both the Sun-3 Architecture Manual
+ * (S5.15) and every driver that has ever driven this board work that way.
+ *
+ * What is modelled is the corner of the Am9516 that Sun uses: channel 1,
+ * word-to-word flyby transfer, a one-shot chain of three register groups.
+ * Nothing here does searches, pattern matching, base-register reload, or
+ * memory-to-memory - the driver never asks for any of it, and a model of the
+ * whole chip would be a model of code nobody runs.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/sysbus.h"
+#include "hw/scsi/ncr5380.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "trace.h"
+#include "system/dma.h"
+#include "system/address-spaces.h"
+
+#define TYPE_SUN3_SI "sun3-si"
+OBJECT_DECLARE_SIMPLE_TYPE(Sun3SiState, SUN3_SI)
+
+
+/* si_csr, from sireg.h. */
+#define SI_CSR_DMA_ACTIVE   0x8000  /* r  */
+/*
+ * DMA_CONFLICT reports a real bus collision: the CPU reached the 5380 while
+ * the UDC was in the middle of a cycle.  It is never set here, and that is
+ * not a simplification.  Arming the UDC and then programming the chip is the
+ * normal order - the PROM writes the mode, target command and start-DMA
+ * registers after the chain is running - and nothing is on the bus until the
+ * chip raises DREQ.  A model that flagged every access during a transfer
+ * would condemn the drivers that exist.
+ */
+#define SI_CSR_DMA_CONFLICT 0x4000  /* r  never set: see above */
+#define SI_CSR_DMA_BUS_ERR  0x2000  /* r  */
+#define SI_CSR_ID           0x1000  /* r  0 for the onboard board */
+#define SI_CSR_FIFO_FULL    0x0800  /* r  */
+#define SI_CSR_FIFO_EMPTY   0x0400  /* r  */
+#define SI_CSR_SBC_IP       0x0200  /* r  the 5380 is interrupting */
+#define SI_CSR_DMA_IP       0x0100  /* r  the UDC is interrupting: an error
+                                     *    only, never terminal count - see
+                                     *    the end of sun3_si_pump() */
+#define SI_CSR_SEND         0x0008  /* rw direction, 1 = to the device */
+#define SI_CSR_INTR_EN      0x0004  /* rw gates both onto level 2 */
+#define SI_CSR_FIFO_RES     0x0002  /* rw active low */
+#define SI_CSR_SCSI_RES     0x0001  /* rw active low; resets the 5380 and UDC */
+
+#define SI_CSR_WRITABLE     (SI_CSR_SEND | SI_CSR_INTR_EN | \
+                             SI_CSR_FIFO_RES | SI_CSR_SCSI_RES)
+
+/* Am9516 register pointers the driver uses, from am9516.h.  Bit 1 of a
+ * pointer selects the channel and Sun uses channel 1 throughout. */
+#define UDC_ADR_MODE        0x38
+#define UDC_ADR_COMMAND     0x2e    /* status when read */
+#define UDC_ADR_CAR_HIGH    0x26
+#define UDC_ADR_CAR_LOW     0x22
+#define UDC_ADR_COUNT       0x32
+
+#define UDC_CMD_RESET       0x00
+#define UDC_CMD_CIE         0x32
+#define UDC_CMD_STRT_CHN    0xa0
+
+#define UDC_SR_CIE          0x8000
+#define UDC_SR_IP           0x2000
+#define UDC_SR_CA           0x1000
+#define UDC_SR_NAC          0x0800
+#define UDC_SR_TC           0x0001
+
+/* Reload-word bits, scanned from 9 down to 0 (Am9516A datasheet, Figure 12).
+ * Sun sends 0x0282 to send and 0x0182 to receive, which is Current ARA or
+ * Current ARB, then the operation count, then the channel mode. */
+#define RSEL_CUR_ARA        (1 << 9)
+#define RSEL_CUR_ARB        (1 << 8)
+#define RSEL_CUR_COUNT      (1 << 7)
+#define RSEL_BASE_ARA       (1 << 6)
+#define RSEL_BASE_ARB       (1 << 5)
+#define RSEL_BASE_COUNT     (1 << 4)
+#define RSEL_PATTERN_MASK   (1 << 3)
+#define RSEL_INT_VECTOR     (1 << 2)
+#define RSEL_CHANNEL_MODE   (1 << 1)
+#define RSEL_CHAIN_ADDR     (1 << 0)
+
+
+struct Sun3SiState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    int irq_level;
+
+    MemoryRegion *dma_mr;
+    AddressSpace dma_as;
+
+    NCR5380State chip;
+    bool pumping;           /* the pump is on the stack already */
+
+    /* Sun's own logic. */
+    uint16_t csr;
+    uint16_t fifo_count;    /* bytes; the driver reads this as the residual */
+    bool saw_drq;           /* the chip has asked at least once this transfer */
+    const char *irq_who;    /* what ran update_irq, for the trace */
+    uint16_t fifo_data;     /* the leftover byte, in bits 15:8 */
+    /* The VME-only registers, indexed by (offset - 8) / 2: written by any
+     * driver that serves both boards, and ignored by this one. */
+    uint16_t vme[13];
+
+    /* The Am9516, as far as Sun uses it. */
+    uint8_t  udc_ptr;
+    uint16_t udc_mode;
+    uint16_t udc_car_hi, udc_car_lo;
+    uint16_t udc_count;     /* words remaining */
+    uint16_t udc_status;
+    uint32_t dma_addr;      /* 24-bit DVMA byte address */
+    uint32_t head;          /* the first four bytes of the transfer, traced */
+    unsigned head_n;
+    bool     dma_running;
+};
+
+static void sun3_si_update_irq(Sun3SiState *s)
+{
+    int level;
+
+    s->csr &= ~SI_CSR_SBC_IP;
+    if (ncr5380_irq(&s->chip)) {
+        s->csr |= SI_CSR_SBC_IP;
+    }
+
+    /* Both the chip and the UDC arrive on level 2, and SBC_INT_EN gates them
+     * both.  The driver tells them apart by these two status bits. */
+    level = (s->csr & SI_CSR_INTR_EN) &&
+            (s->csr & (SI_CSR_SBC_IP | SI_CSR_DMA_IP));
+
+    if (level != s->irq_level) {
+        s->irq_level = level;
+        trace_sun3_si_irq(level, s->csr, s->irq_who ? s->irq_who : "?");
+        qemu_set_irq(s->irq, level);
+    }
+}
+
+/*
+ * Move whatever the chip is asking for.
+ *
+ * A real UDC is woken by DREQ and takes the bus; here the pump is called after
+ * every register access and from the chip's own DRQ and interrupt pins, which
+ * comes to the same thing because nothing else can happen in between.  End of
+ * Process is asserted across the last acknowledge, which is what sets END OF
+ * DMA in the chip.
+ */
+static void sun3_si_pump(Sun3SiState *s)
+{
+    if (!s->dma_running || s->pumping) {
+        /* Re-entered from the DRQ callback, which the software chip raises
+         * from inside dack_read - the byte after this one is already being
+         * asked for.  The loop below has not finished with it yet. */
+        return;
+    }
+    s->pumping = true;
+
+    while (s->fifo_count > 0) {
+        bool last = (s->fifo_count == 1);
+        uint8_t byte;
+
+        if (!ncr5380_drq(&s->chip)) {
+            /* The chip has nothing to hand over yet.  The transfer is over
+             * when the target leaves the phase the chip was set up for: the
+             * chip stops recognising REQ, no further request will come, and
+             * the UDC - fed by a FIFO that has stopped asking - stops with
+             * it.  DMA ACTIVE goes away here and not only at terminal count,
+             * and the byte count is left as the residual for the driver to
+             * read.  SunOS waits for exactly this: si_cmdwait polls the CSR
+             * for DMA ACTIVE to clear and gives up with "DMA_ACTIVE still
+             * on".  A transfer that ends short - 56 bytes of INQUIRY asked
+             * for, 36 given - never reaches terminal count, so a model that
+             * held the bit until then hung every SunOS probe, while NetBSD,
+             * which asks for exactly what it will get, never noticed.
+             *
+             * PHASE MATCH is the signal and the chip's interrupt is not.
+             * An interrupt is a *latch*, and it stays asserted until the
+             * driver reads register 7; one left over from the command before
+             * is asserted at the moment the next transfer starts, so a pump
+             * that ended on it aborted transfers before they had moved a
+             * byte.  That is what "si0: lost interrupt ... count= 8192
+             * (8192)" was: nothing moved, and the driver waited for an
+             * interrupt about a transfer that had never begun.
+             *
+             * But a mismatch only means "over" once the transfer has begun.
+             * The UDC is armed before the chip is told anything: every
+             * driver here starts the chain first and writes the Target
+             * Command Register after, so in that window TCR still holds the
+             * *last* transfer's phase and PHASE MATCH is false about a
+             * transfer that has not started.  Ending there wedges the PROM
+             * on its first read.  So wait for the chip to ask once, and take
+             * the mismatch as the end only after that.
+             */
+#define BSR_PHASE_MATCH 0x08
+            bool matched =
+                (ncr5380_reg_read(&s->chip, 5) & BSR_PHASE_MATCH) != 0;
+            /* Both signals, and neither alone.  The interrupt on its own is a
+             * latch left over from the command before.  The phase on its own
+             * is momentary - it is false between the chip being armed and the
+             * driver writing the Target Command Register, and it flickers
+             * during a transfer, which ended the PROM's boot block read early
+             * and got "scsi: dma never completed".  Together, after the chip
+             * has asked at least once, they mean the target has moved on. */
+            if (s->saw_drq && !matched && ncr5380_irq(&s->chip)) {
+                s->dma_running = false;
+                s->csr &= ~SI_CSR_DMA_ACTIVE;
+                trace_sun3_si_dma_done(s->fifo_count, s->csr, s->head);
+            }
+
+            /* Either way there is nothing to wait for here.  The chip has no
+             * time in it, so if it is not asking now it is waiting on
+             * something only the block layer can finish - and it will say so
+             * by raising DRQ, which brings us straight back.  Spinning would
+             * be worse than pointless: scsi_req_enqueue on a real disk
+             * completes on the AIO path, which cannot run while this function
+             * holds the thread inside an MMIO handler. */
+            s->pumping = false;
+            return;
+        }
+        s->saw_drq = true;
+
+        if (last) {
+            ncr5380_set_eop(&s->chip, true);
+        }
+
+        if (s->csr & SI_CSR_SEND) {
+            if (dma_memory_read(&s->dma_as, s->dma_addr, &byte, 1,
+                                MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+                s->csr |= SI_CSR_DMA_BUS_ERR;
+                break;
+            }
+            ncr5380_dack_write(&s->chip, byte);
+        } else {
+            byte = ncr5380_dack_read(&s->chip);
+            if (dma_memory_write(&s->dma_as, s->dma_addr, &byte, 1,
+                                 MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+                s->csr |= SI_CSR_DMA_BUS_ERR;
+                break;
+            }
+        }
+
+        if (last) {
+            ncr5380_set_eop(&s->chip, false);
+        }
+
+        /* The FIFO packs bytes into words most significant byte first - the
+         * 68020's order, with no swap anywhere on the SCSI path.  A driver
+         * picking up an odd leftover reads it from bits 15:8. */
+        s->fifo_data = (uint16_t)byte << 8;
+        /* Count in the transfer, not in this call: the pump is re-entered
+         * every time the guest touches a register, so a per-call counter
+         * would end up holding the last four bytes rather than the first. */
+        if (s->head_n < 4) {
+            s->head = (s->head << 8) | byte;
+            s->head_n++;
+        }
+        s->dma_addr++;
+        s->fifo_count--;
+        if (s->udc_count > 0 && (s->fifo_count & 1) == 0) {
+            s->udc_count--;
+        }
+    }
+
+    if (s->fifo_count == 0 || (s->csr & SI_CSR_DMA_BUS_ERR)) {
+        /* Terminal count, or a translation failure that forces the UDC's
+         * external EOP.  Either way the transfer is over. */
+        s->dma_running = false;
+        s->csr &= ~SI_CSR_DMA_ACTIVE;
+        trace_sun3_si_dma_done(s->fifo_count, s->csr, s->head);
+        s->udc_status |= UDC_SR_TC | UDC_SR_NAC;
+
+        /*
+         * Reaching terminal count is not an interrupt.  Both drivers arm the
+         * UDC's channel interrupt before every transfer - Sun's comment on
+         * the command says "in case of error" - and SunOS then treats a DMA
+         * interrupt as exactly that: siintr tests DMA_IP before anything
+         * else and, on this board, prints "dma ip, unknown reason" and fails
+         * the command (doc/drivers/SunOS34/sundev/si.c, lines 1516-1553).
+         * Hardware that raised it at terminal count would have failed every
+         * transfer SunOS ever made, so it does not.  Only the error path
+         * interrupts, and the transfer's own end is the chip's business.
+         */
+        if ((s->csr & SI_CSR_DMA_BUS_ERR) && (s->udc_status & UDC_SR_CIE)) {
+            s->udc_status |= UDC_SR_IP;
+            s->csr |= SI_CSR_DMA_IP;
+        }
+    }
+
+    s->pumping = false;
+}
+
+static void sun3_si_udc_reset(Sun3SiState *s)
+{
+    s->dma_running = false;
+    s->udc_mode = 0;
+    s->udc_count = 0;
+    s->udc_status = UDC_SR_CA | UDC_SR_NAC;   /* reset locks the channel out */
+    s->csr &= ~(SI_CSR_DMA_ACTIVE | SI_CSR_DMA_IP);
+}
+
+/*
+ * "Start chaining": the UDC fetches its own setup.  It reads a reload word and
+ * then scans it from bit 9 down to bit 0, taking successive words out of
+ * memory for each selected register.  Sun only ever selects three groups, but
+ * the scan is written out because a driver that selected a fourth would
+ * otherwise be silently misparsed.
+ */
+static void sun3_si_start_chain(Sun3SiState *s)
+{
+    /*
+     * An Am9516 address is a pair of words, and the high word is not simply
+     * the top sixteen bits: A23-A16 sit in its high byte and its low byte is
+     * the reference and control field (Sun writes 0x40 there, "system memory,
+     * increment").  Reading it as a flat 32-bit address puts the chain table
+     * at 0x004000 instead of 0xF04000, which is a translation failure rather
+     * than wrong data, so it shows up as a bus error and not as garbage.
+     */
+    uint32_t at = (((uint32_t)s->udc_car_hi & 0xff00) << 8) | s->udc_car_lo;
+    uint16_t rsel, w;
+    uint16_t addr_hi = 0, addr_lo = 0;
+    bool got_addr = false;
+    int i;
+
+    if (s->udc_status & UDC_SR_CA) {
+        /* Reset leaves the channel aborted; the driver clears that by
+         * starting a chain, which is the only thing that does. */
+        s->udc_status &= ~UDC_SR_CA;
+    }
+
+    if (dma_memory_read(&s->dma_as, at, &rsel, 2,
+                        MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+        s->csr |= SI_CSR_DMA_BUS_ERR;
+        return;
+    }
+    rsel = be16_to_cpu(rsel);
+    at += 2;
+
+    for (i = 9; i >= 0; i--) {
+        int words;
+
+        if (!(rsel & (1 << i))) {
+            continue;
+        }
+        switch (1 << i) {
+        case RSEL_CUR_ARA:
+        case RSEL_CUR_ARB:
+        case RSEL_BASE_ARA:
+        case RSEL_BASE_ARB:
+        case RSEL_CHANNEL_MODE:
+        case RSEL_CHAIN_ADDR:
+        case RSEL_PATTERN_MASK:
+            words = 2;
+            break;
+        default:
+            words = 1;
+            break;
+        }
+
+        while (words--) {
+            if (dma_memory_read(&s->dma_as, at, &w, 2,
+                                MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+                s->csr |= SI_CSR_DMA_BUS_ERR;
+                return;
+            }
+            w = be16_to_cpu(w);
+            at += 2;
+
+            /* Only the fields the transfer needs are kept.  The address
+             * registers arrive upper word first; the upper word carries
+             * A23-A16 in bits 15:8 and the reference and control fields
+             * below, which for Sun are always "system memory, increment". */
+            if ((1 << i) == RSEL_CUR_ARA || (1 << i) == RSEL_CUR_ARB) {
+                if (!got_addr) {
+                    addr_hi = w;
+                    got_addr = true;
+                } else {
+                    addr_lo = w;
+                }
+            } else if ((1 << i) == RSEL_CUR_COUNT) {
+                s->udc_count = w;
+            }
+        }
+    }
+
+    s->dma_addr = (((uint32_t)addr_hi & 0xff00) << 8) | addr_lo;
+    trace_sun3_si_chain(at, rsel, s->dma_addr, s->udc_count);
+    s->udc_status &= ~(UDC_SR_TC | UDC_SR_NAC);
+    s->head = 0;
+    s->head_n = 0;
+    s->saw_drq = false;
+    s->dma_running = true;
+    s->csr |= SI_CSR_DMA_ACTIVE;
+    s->csr &= ~(SI_CSR_DMA_IP | SI_CSR_DMA_BUS_ERR);
+}
+
+static void sun3_si_udc_write(Sun3SiState *s, uint16_t val)
+{
+    switch (s->udc_ptr) {
+    case UDC_ADR_MODE:
+        s->udc_mode = val;
+        break;
+    case UDC_ADR_CAR_HIGH:
+        s->udc_car_hi = val;
+        break;
+    case UDC_ADR_CAR_LOW:
+        s->udc_car_lo = val;
+        break;
+    case UDC_ADR_COUNT:
+        s->udc_count = val;
+        break;
+    case UDC_ADR_COMMAND:
+        trace_sun3_si_udc_cmd(val & 0xff);
+        switch (val & 0xff) {
+        case UDC_CMD_RESET:
+            sun3_si_udc_reset(s);
+            break;
+        case UDC_CMD_CIE:
+            s->udc_status |= UDC_SR_CIE;
+            break;
+        case UDC_CMD_STRT_CHN:
+            sun3_si_start_chain(s);
+            break;
+        default:
+            qemu_log_mask(LOG_UNIMP, "sun3-si: UDC command 0x%02x\n",
+                          val & 0xff);
+            break;
+        }
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "sun3-si: write to UDC register 0x%02x\n",
+                      s->udc_ptr);
+        break;
+    }
+}
+
+static uint16_t sun3_si_udc_read(Sun3SiState *s)
+{
+    switch (s->udc_ptr) {
+    case UDC_ADR_COMMAND:       /* status shares the pointer with command */
+        return s->udc_status;
+    case UDC_ADR_MODE:
+        return s->udc_mode;
+    case UDC_ADR_CAR_HIGH:
+        return s->udc_car_hi;
+    case UDC_ADR_CAR_LOW:
+        return s->udc_car_lo;
+    case UDC_ADR_COUNT:
+        return s->udc_count;
+    default:
+        /* Several UDC registers are not readable in the Sun-3 implementation
+         * at all; the manual says reads return unknown data. */
+        return 0;
+    }
+}
+
+/* The 5380's current phase, for the one place the board cares about it. */
+static bool sun3_si_in_data_phase(Sun3SiState *s)
+{
+    uint8_t csb = ncr5380_reg_read(&s->chip, 4);   /* Current SCSI Bus Status */
+    uint8_t phase = (csb >> 2) & 7;
+    return phase == 0 /* DATA OUT */ || phase == 1 /* DATA IN */;
+}
+
+static uint64_t sun3_si_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Sun3SiState *s = opaque;
+    uint64_t val = 0;
+
+    if (addr < 8) {
+        /* The chip is eight byte-wide registers on a 16-bit bus.  A word
+         * access is two register cycles, high byte first - not one wide
+         * register - and getting that wrong would quietly halve the register
+         * file for anyone who used one. */
+        val = ncr5380_reg_read(&s->chip, addr & 7);
+        if (size == 2) {
+            val = (val << 8) | ncr5380_reg_read(&s->chip, (addr + 1) & 7);
+        }
+    } else {
+        switch (addr) {
+        case 0x10:
+            val = sun3_si_udc_read(s);
+            break;
+        case 0x12:
+            val = s->udc_ptr;
+            break;
+        case 0x14:
+            val = s->fifo_data;
+            break;
+        case 0x16:
+            val = s->fifo_count;
+            break;
+        case 0x08: case 0x0a: case 0x0c: case 0x0e:
+        case 0x1a: case 0x1c: case 0x1e: case 0x20:
+            val = s->vme[(addr - 8) / 2];
+            break;
+        case 0x18:
+            s->irq_who = "csr-read";
+            sun3_si_update_irq(s);
+            s->csr &= ~(SI_CSR_FIFO_FULL | SI_CSR_FIFO_EMPTY);
+            /* The FIFO is empty exactly when there is nothing left to move;
+             * the driver waits on this after a read. */
+            if (!s->dma_running) {
+                s->csr |= SI_CSR_FIFO_EMPTY;
+            }
+            val = s->csr;
+            break;
+        default:
+            qemu_log_mask(LOG_UNIMP, "sun3-si: read 0x%" HWADDR_PRIx "\n",
+                          addr);
+            break;
+        }
+    }
+
+    sun3_si_pump(s);
+    s->irq_who = "read";
+    sun3_si_update_irq(s);
+    trace_sun3_si_reg_read(addr, size, val);
+    return val;
+}
+
+static void sun3_si_write(void *opaque, hwaddr addr, uint64_t val,
+                          unsigned size)
+{
+    Sun3SiState *s = opaque;
+
+    trace_sun3_si_reg_write(addr, size, val);
+    if (addr < 8) {
+        if (size == 2) {
+            ncr5380_reg_write(&s->chip, addr & 7, val >> 8);
+            ncr5380_reg_write(&s->chip, (addr + 1) & 7, val);
+        } else {
+            ncr5380_reg_write(&s->chip, addr & 7, val);
+        }
+    } else {
+        switch (addr) {
+        case 0x10:
+            sun3_si_udc_write(s, val);
+            break;
+        case 0x12:
+            /* Only six bits of pointer, and bit 1 picks the channel. */
+            s->udc_ptr = val & 0x7e;
+            break;
+        case 0x16:
+            /* "The OBIO si IGNORES any attempt to set the FIFO count register
+             * after the SCSI bus goes into any DATA phase" - which is why the
+             * driver sets it during COMMAND or MESSAGE IN.  A model that
+             * accepted it here would let a driver work that could not. */
+            if (!sun3_si_in_data_phase(s)) {
+                s->fifo_count = val;
+            }
+            break;
+        case 0x18: {
+            uint16_t old = s->csr;
+            s->csr = (s->csr & ~SI_CSR_WRITABLE) | (val & SI_CSR_WRITABLE);
+            /* Both resets are active low. */
+            if (!(val & SI_CSR_SCSI_RES)) {
+                sun3_si_udc_reset(s);
+                ncr5380_hard_reset(&s->chip);
+                s->csr &= ~SI_CSR_DMA_BUS_ERR;
+            }
+            if (!(val & SI_CSR_FIFO_RES)) {
+                s->fifo_data = 0;
+            }
+            (void)old;
+            break;
+        }
+        case 0x08: case 0x0a: case 0x0c: case 0x0e:
+        case 0x1a: case 0x1c: case 0x1e: case 0x20:
+            s->vme[(addr - 8) / 2] = val;
+            break;
+        case 0x14:
+            break;      /* read-only */
+        default:
+            qemu_log_mask(LOG_UNIMP, "sun3-si: write 0x%" HWADDR_PRIx "\n",
+                          addr);
+            break;
+        }
+    }
+
+    sun3_si_pump(s);
+    s->irq_who = "write";
+    sun3_si_update_irq(s);
+}
+
+static const MemoryRegionOps sun3_si_ops = {
+    .read = sun3_si_read,
+    .write = sun3_si_write,
+    .endianness = DEVICE_BIG_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 2,
+};
+
+/*
+ * The chip's interrupt moved.
+ *
+ * The board has no timer of its own and needs none, but it does have to
+ * *listen*: an interrupt raised while the guest is between register accesses -
+ * which is every interrupt that ends a transfer - would otherwise sit in the
+ * chip until the driver happened to touch something, and a driver waiting for
+ * that interrupt never will.  That is what a "lost interrupt" is.
+ */
+static void sun3_si_irq_changed(void *opaque, int n, int level)
+{
+    Sun3SiState *s = opaque;
+
+    /* Pump first, because this is also how a *short* transfer ends.  When the
+     * target gives less than was asked for - 36 bytes of INQUIRY against the
+     * 56 SunOS asks for, or the tail of a partial block - the chip stops
+     * asking and never raises DRQ again, so the DRQ callback cannot be what
+     * notices.  What it does instead is interrupt on the phase mismatch, and
+     * the pump's end-of-transfer test is waiting for exactly that pair:
+     * PHASE MATCH gone and the chip interrupting.  Without this the byte
+     * count would sit where it stopped, DMA ACTIVE would never clear, and
+     * SunOS's si_cmdwait would poll the CSR until its watchdog gave up. */
+    sun3_si_pump(s);
+    s->irq_who = "chip";
+    sun3_si_update_irq(s);
+}
+
+/*
+ * DRQ moved.
+ *
+ * A byte can become available with the guest touching nothing at all, when a
+ * read completes on the block layer's own thread, so the chip says so and this
+ * is where the transfer picks up again.  It is the same idea as esp.c's
+ * dma_cb, which lets a command defer itself until an external DMA controller
+ * says go.
+ */
+static void sun3_si_drq_changed(void *opaque, int n, int level)
+{
+    Sun3SiState *s = opaque;
+
+    if (level) {
+        sun3_si_pump(s);
+        s->irq_who = "drq";
+        sun3_si_update_irq(s);
+    }
+}
+
+static void sun3_si_realize(DeviceState *dev, Error **errp)
+{
+    Sun3SiState *s = SUN3_SI(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    /* The UDC masters the bus itself: it is the board's own DMA controller,
+     * and the chip in front of it only says when a byte is ready. */
+    if (s->dma_mr) {
+        address_space_init(&s->dma_as, s->dma_mr, "sun3-si-dma");
+    } else {
+        address_space_init(&s->dma_as, get_system_memory(), "sun3-si-dma");
+    }
+
+    object_initialize_child(OBJECT(dev), "ncr5380", &s->chip, TYPE_NCR5380);
+    if (!qdev_realize(DEVICE(&s->chip), NULL, errp)) {
+        return;
+    }
+
+    /* The bus takes the board as its parent, as esp.c's does: a device
+     * realized with no parent bus is not reachable from the qdev tree, and
+     * neither is a bus hanging off one. */
+    ncr5380_bus_init(&s->chip, dev);
+    qdev_connect_gpio_out(DEVICE(&s->chip), 0,
+                          qemu_allocate_irq(sun3_si_irq_changed, s, 0));
+    qdev_connect_gpio_out_named(DEVICE(&s->chip), "drq", 0,
+                                qemu_allocate_irq(sun3_si_drq_changed, s, 0));
+
+    sun3_si_udc_reset(s);
+    s->csr = SI_CSR_FIFO_EMPTY;     /* ID reads 0 on the onboard board */
+    s->fifo_count = 0;
+    s->irq_level = 0;
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &sun3_si_ops, s,
+                          TYPE_SUN3_SI, 0x28);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+
+    /* -drive if=scsi becomes an scsi-hd on the chip's bus.  The machine sets
+     * block_default_type to IF_SCSI, so a bare -drive file= lands here too. */
+    scsi_bus_legacy_handle_cmdline(&s->chip.bus);
+}
+
+static const Property sun3_si_properties[] = {
+    DEFINE_PROP_LINK("dma_mr", Sun3SiState, dma_mr,
+                     TYPE_MEMORY_REGION, MemoryRegion *),
+};
+
+static void sun3_si_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = sun3_si_realize;
+    dc->desc = "Sun-3 onboard SCSI: NCR 5380 with an Am9516 UDC";
+    device_class_set_props(dc, sun3_si_properties);
+    set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
+}
+
+static const TypeInfo sun3_si_info = {
+    .name          = TYPE_SUN3_SI,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Sun3SiState),
+    .class_init    = sun3_si_class_init,
+};
+
+static void sun3_si_register_types(void)
+{
+    type_register_static(&sun3_si_info);
+}
+
+type_init(sun3_si_register_types)
