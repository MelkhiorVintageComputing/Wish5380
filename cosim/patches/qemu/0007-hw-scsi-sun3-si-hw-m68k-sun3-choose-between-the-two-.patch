+/*
+ * DRQ moved.
+ *
+ * On the RTL path nothing is connected to this: that core only advances when
+ * it is stepped, so the pump can see DRQ come up by stepping it, and does.
+ * The software chip is the other way round - a byte can become available with
+ * the guest touching nothing at all, when a read completes on the block
+ * layer's own thread - so it says so, and this is where the transfer picks up
+ * again.  It is the same idea as esp.c's dma_cb, which lets a command defer
+ * itself until an external DMA controller says go.
+ */
+/*
+ * The chip's interrupt moved.
+ *
+ * On the RTL path the board notices by polling si_irq() at the foot of every
+ * register access and from its 500 us timer, because a Verilated core cannot
+ * tell anyone anything - it only exists while it is being stepped.  The
+ * software chip has no timer behind it and needs none, but it does need to be
+ * *listened* to: an interrupt raised while the guest is between accesses -
+ * which is every interrupt that ends a transfer - would otherwise sit in the
+ * chip until the driver happened to touch a register, and a driver waiting
+ * for that interrupt never will.  That is what "lost interrupt" means.
+ */
+static void sun3_si_irq_changed(void *opaque, int n, int level)
+{
+    Sun3SiState *s = opaque;
+
+    /* Pump first, because this is also how a *short* transfer ends.  When the
+     * target gives less than was asked for - 36 bytes of INQUIRY against the
+     * 56 SunOS asks for, or the tail of a partial block - the chip stops
+     * asking and never raises DRQ again, so the DRQ callback cannot be what
+     * notices.  What it does instead is interrupt on the phase mismatch, and
+     * the pump's end-of-transfer test is waiting for exactly that pair:
+     * PHASE MATCH gone and the chip interrupting.  Without this the byte
+     * count would sit where it stopped, DMA ACTIVE would never clear, and
+     * SunOS's si_cmdwait would poll the CSR until its watchdog gave up. */
+    sun3_si_pump(s);
+    s->irq_who = "chip";
+    sun3_si_update_irq(s);
+}
+
+static void sun3_si_drq_changed(void *opaque, int n, int level)
+{
+    Sun3SiState *s = opaque;
+
+    if (level) {
+        sun3_si_pump(s);
+        s->irq_who = "drq";
+        sun3_si_update_irq(s);
+    }
+}
