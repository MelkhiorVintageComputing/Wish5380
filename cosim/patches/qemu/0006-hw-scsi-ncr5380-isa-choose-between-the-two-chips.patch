-    dc->unrealize = ncr5380_unrealize;
-    device_class_set_legacy_reset(dc, ncr5380_reset);
-    dc->desc = "NCR 5380 SCSI on an ISA card, behind the Verilated wish5380";
-    device_class_set_props(dc, ncr5380_properties);
+    dc->realize = ncr5380_isa_realize;
+    dc->unrealize = ncr5380_isa_unrealize;
+    device_class_set_legacy_reset(dc, ncr5380_isa_reset);
+    dc->desc = "NCR 5380 SCSI on an ISA card";
+    device_class_set_props(dc, ncr5380_isa_properties);
     set_bit(DEVICE_CATEGORY_STORAGE, dc->categories);
 }
 
-static const TypeInfo ncr5380_info = {
+static const TypeInfo ncr5380_isa_info = {
     .name          = TYPE_NCR5380_ISA,
     .parent        = TYPE_ISA_DEVICE,
     .instance_size = sizeof(Ncr5380IsaState),
-    .class_init    = ncr5380_class_init,
+    .class_init    = ncr5380_isa_class_init,
 };
 
-static void ncr5380_register_types(void)
+static void ncr5380_isa_register_types(void)
 {
-    type_register_static(&ncr5380_info);
+    type_register_static(&ncr5380_isa_info);
 }
 
-type_init(ncr5380_register_types)
+type_init(ncr5380_isa_register_types)
