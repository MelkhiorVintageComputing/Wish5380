From a8649b1a5c097d7863293c99b2485d37df3bf333 Mon Sep 17 00:00:00 2001
From: Romain Dolbeau <romain@dolbeau.org>
Date: Sat, 8 Aug 2026 11:54:26 +0200
Subject: [PATCH 8/9] hw/scsi/ncr5380: settle the wires, and let a level refill

Two bugs, both found by driving this model and the Verilated one through
the same register sequences and comparing every read.

The settle loop stopped as soon as no *state* had changed, without
checking whether the wires had finished converging.  They need to: what
this chip drives depends on what it sees, because as an initiator it
only drives the data lines while the phase matches - and the phase is on
wires it may itself have been driving a moment ago.  Leaving target mode
is the case that bites.  The chip stops driving MSG and C/D, the phase
it was matching disappears, and it must stop driving the data bus in the
same instant; one pass left the old byte sitting on the bus until
something else happened to disturb it.  The combinational half now runs
to its own fixed point before each edge, and the wires are part of the
loop's termination test as well as the state.

The Verilated model gets this for nothing, because it is a comb block -
`drive_o` depending on `bus_i` is exactly why sci_bus.sv carries a
UNOPTFLAT suppression.  Here it has to be iterated by hand.

And emptying BUSY ERROR was treated as the end of it.  It is a level:
"set whenever the MONITOR BUSY bit is true and BSY is false" (p. 16), so
the condition that filled the latch is still true after a driver reads
register 7, and the next pass fills it again.  Without asking for that
pass the error went away and stayed away - which would make
NCR5380_intr's careful ordering, Mode Register before register 7,
pointless, and would let a driver that got it backwards appear to work.

With both fixed the two models agree over eight seeds of a twenty
thousand step random walk - about 68000 reads compared - and over
thirteen scripted sequences, one per datasheet trap.
---
 hw/scsi/ncr5380.c | 54 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 52 insertions(+), 2 deletions(-)

diff --git a/hw/scsi/ncr5380.c b/hw/scsi/ncr5380.c
index 4e4f635034..81595b02f8 100644
--- a/hw/scsi/ncr5380.c
+++ b/hw/scsi/ncr5380.c
@@ -154,6 +154,14 @@ static void ncr5380_wires_or(NCR5380Wires *out, const NCR5380Wires *a,
     out->dbp  = a->dbp  || b->dbp;
 }
 
+static bool ncr5380_wires_eq(const NCR5380Wires *a, const NCR5380Wires *b)
+{
+    return a->rst == b->rst && a->bsy == b->bsy && a->sel == b->sel &&
+           a->req == b->req && a->ack == b->ack && a->atn == b->atn &&
+           a->msg == b->msg && a->cd == b->cd && a->io == b->io &&
+           a->data == b->data && a->dbp == b->dbp;
+}
+
 static bool ncr5380_phase_match(NCR5380State *s)
 {
     uint8_t on_bus = (s->wires.msg ? 4 : 0) | (s->wires.cd ? 2 : 0) |
@@ -450,7 +458,15 @@ static void ncr5380_tick(NCR5380State *s)
                  (s->st_csd_rd || recv_latch);
 
     if (s->st_rpi) {
+        /* Emptying a level-sensitive latch is not the end of it: the
+         * condition that filled it is still true, and the next pass fills it
+         * again.  Asking for that pass is the whole of what makes BUSY ERROR
+         * a level rather than an edge - without it a driver that
+         * acknowledged would see the error go away and stay away, and
+         * NCR5380_intr's careful ordering (Mode Register first, register 7
+         * second) would be pointless. */
         s->busy_err = false;
+        s->dirty = true;
     } else if (busy_lost) {
         s->busy_err = true;
         s->dirty = true;
@@ -538,11 +554,45 @@ static void ncr5380_settle(NCR5380State *s)
 
     s->settling = true;
     for (i = 0; i < SETTLE_MAX; i++) {
+        NCR5380Wires before = s->wires;
+        int j;
+
         s->dirty = false;
-        ncr5380_drive(s);
-        ncr5380_wires_or(&s->wires, &s->drv, &s->peer);
+
+        /*
+         * The combinational half first, to its own fixed point, because what
+         * this chip drives depends on what it sees: as an initiator it only
+         * drives the data lines while the phase matches, and the phase is on
+         * wires it may itself have been driving a moment ago.  Leaving target
+         * mode is the case that bites - the chip stops driving MSG and C/D,
+         * the phase it was matching disappears, and it must stop driving the
+         * data bus in the same instant.  One pass would leave the old byte on
+         * the bus until something else happened to disturb it.
+         *
+         * The Verilated model gets this for nothing: it is a comb block, and
+         * `drive_o` depending on `bus_i` is the reason sci_bus.sv carries a
+         * UNOPTFLAT suppression.  Here it has to be iterated by hand.
+         */
+        for (j = 0; j < SETTLE_MAX; j++) {
+            NCR5380Wires prev = s->wires;
+
+            ncr5380_drive(s);
+            ncr5380_wires_or(&s->wires, &s->drv, &s->peer);
+            if (ncr5380_wires_eq(&prev, &s->wires)) {
+                break;
+            }
+        }
+
+        /* Then the edge, and then whatever the other end makes of it. */
         ncr5380_tick(s);
         ncr5380_target_settled(s);
+
+        /* A target that drove something new has changed the wires without
+         * changing any of this chip's state, so the wires are part of the
+         * termination test and not only the state. */
+        if (!ncr5380_wires_eq(&before, &s->wires)) {
+            s->dirty = true;
+        }
         if (!s->dirty) {
             break;
         }
