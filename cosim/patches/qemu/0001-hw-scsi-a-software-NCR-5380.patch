diff --git a/include/hw/scsi/ncr5380.h b/include/hw/scsi/ncr5380.h
new file mode 100644
index 0000000000..0521a1da82
--- /dev/null
+++ b/include/hw/scsi/ncr5380.h
@@ -0,0 +1,199 @@
+/*
+ * NCR 5380 SCSI protocol controller.
+ *
+ * SPDX-License-Identifier: MIT
+ *
+ * The chip, separately from any board that carries it.  Every machine that
+ * used a 5380 presented the same eight registers, because the part decoded
+ * /CS with A0..A2 and /IOR or /IOW on the die (design manual p. 6); what the
+ * boards differ in is where those registers land, whether there is a DMA
+ * controller in front of them, and what answers DRQ.  So the boards are
+ * separate objects and this is what they all embed, in the same way esp.c
+ * splits TYPE_ESP from the three boards that carry an ESP.
+ *
+ * Page numbers throughout are the printed pages of the NCR 5380 family design
+ * manual, March 1986.
+ */
+
+#ifndef HW_SCSI_NCR5380_H
+#define HW_SCSI_NCR5380_H
+
+#include "hw/scsi/scsi.h"
+#include "hw/core/irq.h"
+#include "qom/object.h"
+
+#define TYPE_NCR5380 "ncr5380"
+OBJECT_DECLARE_SIMPLE_TYPE(NCR5380State, NCR5380)
+
+/*
+ * The SCSI bus as this chip sees it, active *high*.
+ *
+ * A real bus is wired-OR over open-collector drivers and every signal is
+ * asserted low; taking the inversion out at the pad turns the wired-OR into a
+ * plain OR and leaves one less thing to get backwards.  This is the same
+ * decision, and the same field list, as scsi_t in the Verilated model's
+ * src/wish5380_pkg.sv, so that the two can be read side by side.
+ */
+typedef struct NCR5380Wires {
+    bool rst;
+    bool bsy;
+    bool sel;
+    bool req;
+    bool ack;
+    bool atn;
+    bool msg;
+    bool cd;
+    bool io;
+    uint8_t data;
+    bool dbp;                   /* the parity bit as driven, not as computed */
+} NCR5380Wires;
+
+/* The DMA handshake, pp. 14 and 24.  Named for what the chip is waiting for,
+ * and deliberately the same eight states as the Verilated model's sci_bus.sv:
+ * a difference between the two should be visible as a difference in the
+ * state's name and not buried in a re-derivation. */
+typedef enum NCR5380DmaState {
+    NCR5380_DMA_IDLE,
+    NCR5380_DMA_S_WANT,         /* send: waiting for the host's byte */
+    NCR5380_DMA_S_HAVE,         /* send: byte in ODR, not offered yet */
+    NCR5380_DMA_S_HS,           /* send: our handshake asserted */
+    NCR5380_DMA_S_TREL,         /* send, as target: waiting for ACK to go */
+    NCR5380_DMA_R_WANT,         /* recv: waiting for a byte */
+    NCR5380_DMA_R_HAVE,         /* recv: byte in IDR, DRQ up */
+    NCR5380_DMA_R_HS,           /* recv: our handshake asserted */
+} NCR5380DmaState;
+
+/* Where the target side of the bus has got to.  This is the phase sequence a
+ * direct-access device walks, and it is what the adapter to QEMU's SCSIBus
+ * turns into scsi_req_new / scsi_req_continue / complete. */
+typedef enum NCR5380Phase {
+    NCR5380_PH_FREE,
+    NCR5380_PH_SELECTED,        /* BSY asserted, waiting for SEL to drop */
+    NCR5380_PH_MSG_OUT,
+    NCR5380_PH_COMMAND,
+    NCR5380_PH_DATA_IN,
+    NCR5380_PH_DATA_OUT,
+    NCR5380_PH_STATUS,
+    NCR5380_PH_MSG_IN,
+} NCR5380Phase;
+
+/* The byte handshake, from the target's side: settle the lines, offer the
+ * byte with REQ, wait for ACK to go away again. */
+typedef enum NCR5380Hs {
+    NCR5380_HS_SETUP,
+    NCR5380_HS_REQ,
+    NCR5380_HS_REL,
+} NCR5380Hs;
+
+struct NCR5380State {
+    DeviceState parent_obj;
+
+    SCSIBus bus;
+    qemu_irq irq;               /* the IRQ pin */
+    qemu_irq drq;               /* the DRQ pin */
+
+    /* ---- the five registers that are storage (p. 10) ------------------- */
+    uint8_t odr;                /* Output Data */
+    uint8_t icr;                /* Initiator Command, as written */
+    uint8_t mr;                 /* Mode */
+    uint8_t tcr;                /* Target Command */
+    uint8_t ser;                /* Select Enable */
+
+    /* ---- the engine's own state --------------------------------------- */
+    uint8_t idr;                /* Input Data, latched by a DMA receive */
+    bool aip;                   /* ICR bit 6 on read */
+    bool lost_arb;              /* ICR bit 5 on read */
+    bool arb_active;
+    uint8_t arb_id;             /* the ODR when arbitration began (p. 12) */
+
+    bool par_err;               /* BSR bit 5, emptied by reading register 7 */
+    bool busy_err;              /* BSR bit 2, and level sensitive (p. 16) */
+    bool irq_latch;             /* BSR bit 4 */
+    bool end_dma;               /* BSR bit 7, cleared only by clearing MR.DMA */
+
+    NCR5380DmaState dma_st;
+    bool dma_tgt;               /* the role the transfer was started in */
+    bool drq_raw;               /* before the MR.DMA gate */
+    bool eop;                   /* the End of Process pin */
+
+    bool prev_req;              /* edge detectors */
+    bool prev_rst;
+
+    /* ---- the wires ----------------------------------------------------- */
+    NCR5380Wires drv;           /* what this chip drives */
+    NCR5380Wires peer;          /* what everything else drives */
+    NCR5380Wires wires;         /* the OR of the two: what everybody sees */
+
+    /* ---- strobes, consumed by the next settle -------------------------- */
+    bool st_csd_rd;             /* read 0:  where parity is checked (p. 21) */
+    bool st_rpi;                /* read 7:  Reset Parity/Interrupt */
+    bool st_sds;                /* write 5: Start DMA Send */
+    bool st_sdtr;               /* write 6: Start DMA Target Receive */
+    bool st_sdir;               /* write 7: Start DMA Initiator Receive */
+    bool st_dack_rd;
+    bool st_dack_wr;
+
+    /* ---- the target side: QEMU's SCSI bus behind a phase sequence ------ */
+    NCR5380Phase phase;
+    NCR5380Hs hs;
+    SCSIDevice *sdev;
+    SCSIRequest *sreq;
+    int sel_id;
+    int sel_lun;
+    bool atn_at_select;
+
+    uint8_t cdb[16];
+    int cdb_n;
+    int cdb_len;
+
+    uint8_t *async_buf;         /* scsi_req_get_buf's window */
+    uint32_t async_len;
+    uint32_t async_off;
+    uint8_t status;
+    uint8_t hs_byte;            /* the byte REQ is offering, on the way in */
+
+    /* ---- housekeeping --------------------------------------------------- */
+    bool settling;              /* re-entrancy guard on the settle loop */
+    bool dirty;
+    int irq_level;
+    int drq_level;
+};
+
+/*
+ * What a board may do to the chip.  This is the whole of it, and its
+ * smallness is a property of the part: a 5380 has no address counter and no
+ * byte counter, so it never masters a bus and there is no guest memory for it
+ * to reach.  Everything else a board does - decoding a register window,
+ * counting bytes, driving an Am9516 - is the board's own.
+ */
+
+/* Give the chip its SCSI bus, and bring it up.  Called by the board once it
+ * has realized the chip, and passing the *board* so that the bus is reachable
+ * from the qdev tree - see the comment on the implementation. */
+void ncr5380_bus_init(NCR5380State *s, DeviceState *board);
+
+/* The RESET pin.  Clears everything, including the interrupt latch, which is
+ * what distinguishes it from an SCSI bus reset (p. 23). */
+void ncr5380_hard_reset(NCR5380State *s);
+
+/* The eight registers, as A2..A0 select them.  A read of 7 and a write of 5,
+ * 6 or 7 are events and not accesses to storage, so each must be called
+ * exactly once per guest access and never speculatively. */
+uint8_t ncr5380_reg_read(NCR5380State *s, int reg);
+void ncr5380_reg_write(NCR5380State *s, int reg, uint8_t val);
+
+/* The DMA handshake.  An access with DACK asserted does not decode the
+ * address at all (p. 6) - the DMA controller has no address lines to offer -
+ * which is why there is no register number here. */
+bool ncr5380_drq(NCR5380State *s);
+uint8_t ncr5380_dack_read(NCR5380State *s);
+void ncr5380_dack_write(NCR5380State *s, uint8_t val);
+
+/* Hold End of Process asserted across the next acknowledge cycle, which is
+ * what sets END OF DMA and, if it is enabled, interrupts. */
+void ncr5380_set_eop(NCR5380State *s, bool asserted);
+
+/* The interrupt pin, as it stands now. */
+bool ncr5380_irq(NCR5380State *s);
+
+#endif /* HW_SCSI_NCR5380_H */
-- 
