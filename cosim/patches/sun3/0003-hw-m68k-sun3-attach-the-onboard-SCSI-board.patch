From 447acb7883a993417b7f52f6d14dcd2e11c02924 Mon Sep 17 00:00:00 2001
From: Romain Dolbeau <romain@dolbeau.org>
Date: Mon, 3 Aug 2026 22:23:20 +0200
Subject: [PATCH 3/3] hw/m68k/sun3: attach the onboard SCSI board

At obio 0x140000, one slot above the Lance, on interrupt level 2, with
the machine's DVMA IOMMU as its bus master window - the same wiring the
Lance already uses.

It appears only when the machine is given a controller to put there.
Without si-rtl= nothing is mapped and the PROM says "Device not found",
which is what a 3/60 with an empty SCSI bus does anyway, so every
existing test keeps passing unchanged.

    -M sun3,si-rtl=/path/libwish5380rtl.so,si-image=disk.img

Signed-off-by: Romain Dolbeau <romain@dolbeau.org>
---
 hw/m68k/Kconfig |  1 +
 hw/m68k/sun3.c  | 62 +++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 63 insertions(+)

diff --git a/hw/m68k/Kconfig b/hw/m68k/Kconfig
index 59b36c75ee..14ea11c31c 100644
--- a/hw/m68k/Kconfig
+++ b/hw/m68k/Kconfig
@@ -54,3 +54,4 @@ config SUN3
     select ESCC
     select LANCE
     select INTERSIL7170
+    select SUN3_SI
diff --git a/hw/m68k/sun3.c b/hw/m68k/sun3.c
index a60899b8c2..62106c2c55 100644
--- a/hw/m68k/sun3.c
+++ b/hw/m68k/sun3.c
@@ -53,6 +53,10 @@ struct Sun3MachineState {
     DeviceState *irqc_dev;
     DeviceState *sun3mmu;
 
+    /* Onboard SCSI, which only exists if it was asked for */
+    char *si_rtl;
+    char *si_image;
+
     /* Boot State */
     uint32_t boot_sp;
     uint32_t boot_pc;
@@ -473,6 +477,29 @@ static void sun3_init(MachineState *machine)
     sysbus_mmio_map(s, 0, 0x0FF20000);
     sysbus_connect_irq(s, 0, qdev_get_gpio_in(irqc_dev, M68K_IRQC_LEVEL_3));
 
+    /*
+     * The onboard SCSI, obio 0x140000, one slot above the Lance.  It appears
+     * only when the machine is given a controller to put there - without
+     * si-rtl= the region stays unmapped and the PROM says "Device not found",
+     * which is what a 3/60 with nothing on the bus does anyway.
+     */
+    if (s_mach->si_rtl) {
+        DeviceState *si_dev = qdev_new("sun3-si");
+
+        qdev_prop_set_string(si_dev, "rtl", s_mach->si_rtl);
+        if (s_mach->si_image) {
+            qdev_prop_set_string(si_dev, "image", s_mach->si_image);
+        }
+        object_property_set_link(OBJECT(si_dev), "dma_mr",
+                                 OBJECT(&SUN3_MMU(sun3mmu)->dvma_iommu),
+                                 &error_abort);
+        s = SYS_BUS_DEVICE(si_dev);
+        sysbus_realize_and_unref(s, &error_fatal);
+        sysbus_mmio_map(s, 0, 0x0FF40000);
+        sysbus_connect_irq(s, 0,
+                           qdev_get_gpio_in(irqc_dev, M68K_IRQC_LEVEL_2));
+    }
+
     memory_region_init_ram(&s_mach->eeprom, NULL, "sun3.eeprom", 2048,
                            &error_fatal);
     memory_region_add_subregion(get_system_memory(), 0x0FE40000,
@@ -492,6 +519,32 @@ static void sun3_init(MachineState *machine)
                                         &s_mach->timeout_net, -10);
 }
 
+static char *sun3_get_si_rtl(Object *obj, Error **errp)
+{
+    return g_strdup(SUN3_MACHINE(obj)->si_rtl);
+}
+
+static void sun3_set_si_rtl(Object *obj, const char *value, Error **errp)
+{
+    Sun3MachineState *s_mach = SUN3_MACHINE(obj);
+
+    g_free(s_mach->si_rtl);
+    s_mach->si_rtl = g_strdup(value);
+}
+
+static char *sun3_get_si_image(Object *obj, Error **errp)
+{
+    return g_strdup(SUN3_MACHINE(obj)->si_image);
+}
+
+static void sun3_set_si_image(Object *obj, const char *value, Error **errp)
+{
+    Sun3MachineState *s_mach = SUN3_MACHINE(obj);
+
+    g_free(s_mach->si_image);
+    s_mach->si_image = g_strdup(value);
+}
+
 static void sun3_machine_class_init(ObjectClass *oc, const void *data)
 {
     MachineClass *mc = MACHINE_CLASS(oc);
@@ -504,6 +557,15 @@ static void sun3_machine_class_init(ObjectClass *oc, const void *data)
     mc->default_ram_id = "sun3.ram";
 
     mc->ignore_memory_transaction_failures = false;
+
+    object_class_property_add_str(oc, "si-rtl",
+                                  sun3_get_si_rtl, sun3_set_si_rtl);
+    object_class_property_set_description(oc, "si-rtl",
+        "shared library implementing the onboard SCSI controller");
+    object_class_property_add_str(oc, "si-image",
+                                  sun3_get_si_image, sun3_set_si_image);
+    object_class_property_set_description(oc, "si-image",
+        "backing file for the disk behind the onboard SCSI controller");
 }
 
 static const TypeInfo sun3_machine_type = {
-- 
2.39.5

