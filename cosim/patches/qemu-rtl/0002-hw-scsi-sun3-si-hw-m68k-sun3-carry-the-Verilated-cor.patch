 #define TYPE_SUN3_SI "sun3-si"
 OBJECT_DECLARE_SIMPLE_TYPE(Sun3SiState, SUN3_SI)
 
+/* Must match cosim/rtl/wish_rtl.h in the Wish5380 tree. */
+#define WISH_RTL_ABI 2
+typedef struct WishRtl WishRtl;
 
 /* si_csr, from sireg.h. */
 #define SI_CSR_DMA_ACTIVE   0x8000  /* r  */
@@ -119,6 +127,40 @@ OBJECT_DECLARE_SIMPLE_TYPE(Sun3SiState, SUN3_SI)
 #define RSEL_CHANNEL_MODE   (1 << 1)
 #define RSEL_CHAIN_ADDR     (1 << 0)
 
+/*
+ * Pacing.
+ *
+ * A Verilated 5380 with an SD card behind it runs about sixteen times slower
+ * than the part it models, so the core cannot simply be run at the emulator's
+ * virtual rate - the whole machine would crawl, selftest and all.  What makes
+ * that affordable is that the chip is idle for almost all of a boot: the bus
+ * is free, nothing is selected, and no amount of simulation would change any
+ * answer the guest could read.
+ *
+ * So the core is advanced to virtual time only while something is actually
+ * happening - a transfer in flight, or BSY asserted on the SCSI bus.  Then it
+ * keeps step with the guest exactly, which is what makes the guest's own
+ * timeouts mean what they say; the rest of the time it costs nothing.  Each
+ * register access also buys a little core time, so a driver polling a status
+ * register still makes progress between timer ticks.
+ */
+#define STEP_PER_ACCESS_NS  1000
+#define TIMER_PERIOD_NS     (500 * 1000)
+#define MAX_CATCH_UP_NS     (2 * 1000 * 1000)
+
+/*
+ * How long the controller will wait for the chip to ask for the next byte
+ * before giving up and letting the emulator get on with something else.
+ *
+ * It has to wait rather than sample.  A real UDC holds the bus and answers
+ * DREQ when it comes; if this only looked at DRQ once per guest register
+ * access, a transfer would advance about one byte per poll and 8 kilobytes
+ * would take seconds.  The wait resets on every byte moved, so the budget is
+ * "how long a gap between bytes is still a live transfer" - and the longest
+ * real gap is the SD card fetching the next block, about a millisecond.
+ */
+#define DRQ_WAIT_NS         (4 * 1000 * 1000)
+#define DRQ_STEP_NS         100
 
 struct Sun3SiState {
     SysBusDevice parent_obj;
@@ -126,11 +168,18 @@ struct Sun3SiState {
     MemoryRegion iomem;
     qemu_irq irq;
     int irq_level;
+    QEMUTimer *timer;
 
     MemoryRegion *dma_mr;
     AddressSpace dma_as;
 
-    NCR5380State chip;
+    char *core;
+    char *rtl;
+    char *image;
+    uint32_t blocks;
+
+    bool use_rtl;
+    NCR5380State chip;      /* only realized when use_rtl is false */
     bool pumping;           /* the pump is on the stack already */
 
     /* Sun's own logic. */
@@ -138,6 +187,8 @@ struct Sun3SiState {
     uint16_t fifo_count;    /* bytes; the driver reads this as the residual */
     bool saw_drq;           /* the chip has asked at least once this transfer */
     const char *irq_who;    /* what ran update_irq, for the trace */
+    uint64_t clamped;       /* catch-ups cut short by MAX_CATCH_UP_NS */
+    int64_t core0, guest0;  /* clocks when the core was first run */
     uint16_t fifo_data;     /* the leftover byte, in bits 15:8 */
     /* The VME-only registers, indexed by (offset - 8) / 2: written by any
      * driver that serves both boards, and ignored by this one. */
@@ -152,15 +203,143 @@ struct Sun3SiState {
     uint32_t dma_addr;      /* 24-bit DVMA byte address */
     uint32_t head;          /* the first four bytes of the transfer, traced */
     unsigned head_n;
+    unsigned stalled;       /* timer ticks with a transfer making no progress */
     bool     dma_running;
+
+    int64_t last_ns;
+
+    void *dl;
+    WishRtl *dev;
+
+    uint32_t (*f_abi)(void);
+    WishRtl *(*f_new)(const char *, uint32_t);
+    void (*f_free)(WishRtl *);
+    void (*f_flush)(WishRtl *);
+    int (*f_reset)(WishRtl *);
+    void (*f_write)(WishRtl *, int, uint8_t);
+    uint8_t (*f_read)(WishRtl *, int);
+    int (*f_irq)(WishRtl *);
+    int (*f_drq)(WishRtl *);
+    uint8_t (*f_dack_read)(WishRtl *);
+    void (*f_dack_write)(WishRtl *, uint8_t);
+    void (*f_set_eop)(WishRtl *, int);
+    void (*f_run_ns)(WishRtl *, uint64_t);
+    uint64_t (*f_time_ns)(WishRtl *);
 };
 
+/*
+ * Which 5380, per call.
+ *
+ * The board's own logic - the Am9516 chain, the packing FIFO, the CSR - is
+ * about the chip's observable pins and not about how the chip is built, so it
+ * is written once and these eight functions are the whole of the difference
+ * between a Verilated core behind a shared library and hw/scsi/ncr5380.c
+ * compiled in.
+ */
+static uint8_t si_read(Sun3SiState *s, int reg)
+{
+    return s->use_rtl ? s->f_read(s->dev, reg)
+                      : ncr5380_reg_read(&s->chip, reg);
+}
+
+static void si_write(Sun3SiState *s, int reg, uint8_t val)
+{
+    if (s->use_rtl) {
+        s->f_write(s->dev, reg, val);
+    } else {
+        ncr5380_reg_write(&s->chip, reg, val);
+    }
+}
+
+static int si_irq(Sun3SiState *s)
+{
+    return s->use_rtl ? s->f_irq(s->dev) : ncr5380_irq(&s->chip);
+}
+
+static int si_drq(Sun3SiState *s)
+{
+    return s->use_rtl ? s->f_drq(s->dev) : ncr5380_drq(&s->chip);
+}
+
+static uint8_t si_dack_read(Sun3SiState *s)
+{
+    return s->use_rtl ? s->f_dack_read(s->dev)
+                      : ncr5380_dack_read(&s->chip);
+}
+
+static void si_dack_write(Sun3SiState *s, uint8_t val)
+{
+    if (s->use_rtl) {
+        s->f_dack_write(s->dev, val);
+    } else {
+        ncr5380_dack_write(&s->chip, val);
+    }
+}
+
+static void si_set_eop(Sun3SiState *s, int asserted)
+{
+    if (s->use_rtl) {
+        s->f_set_eop(s->dev, asserted);
+    } else {
+        ncr5380_set_eop(&s->chip, asserted != 0);
+    }
+}
+
+static int si_reset(Sun3SiState *s)
+{
+    if (s->use_rtl) {
+        return s->f_reset(s->dev);
+    }
+    ncr5380_hard_reset(&s->chip);
+    return 1;
+}
+
+/*
+ * Give the core some time.
+ *
+ * Only the Verilated one has any: it advances when it is stepped and not
+ * otherwise, and the SCSI target and SD card behind it have to advance while
+ * the guest is between accesses.  The software chip settles its wires inside
+ * each access and has nothing to advance, so every one of these calls, the
+ * catch-up, the settle and the 500 us timer are simply not there on that path.
+ */
+static void si_run_ns(Sun3SiState *s, uint64_t ns)
+{
+    if (s->use_rtl) {
+        s->f_run_ns(s->dev, ns);
+    }
+}
+
+/*
+ * How far the core has fallen behind the guest.
+ *
+ * catch_up runs the core to virtual time but never by more than
+ * MAX_CATCH_UP_NS at a stroke, so a guest that advances further than that
+ * between two accesses leaves the core permanently behind - and a transfer
+ * that is prompt in the core's own time is late in the guest's, which is
+ * exactly what a driver watchdog measures.  Both clocks start together the
+ * first time the core is run; the difference is what this reports.
+ */
+static void sun3_si_clock(Sun3SiState *s, const char *what)
+{
+    int64_t guest, core;
+
+    if (!s->use_rtl) {
+        return;         /* nothing to diverge: the software chip has no clock */
+    }
+    guest = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->guest0;
+    core = (int64_t)s->f_time_ns(s->dev) - s->core0;
+
+    trace_sun3_si_clock(what, guest / 1000, core / 1000,
+                        (guest - core) / 1000, s->clamped);
+}
+
 static void sun3_si_update_irq(Sun3SiState *s)
 {
     int level;
 
     s->csr &= ~SI_CSR_SBC_IP;
-    if (ncr5380_irq(&s->chip)) {
+    if (si_irq(s)) {
         s->csr |= SI_CSR_SBC_IP;
     }
 
@@ -172,21 +351,83 @@ static void sun3_si_update_irq(Sun3SiState *s)
     if (level != s->irq_level) {
         s->irq_level = level;
         trace_sun3_si_irq(level, s->csr, s->irq_who ? s->irq_who : "?");
+        if (level) {
+            sun3_si_clock(s, "irq-raised");
+        }
         qemu_set_irq(s->irq, level);
     }
 }
 
+/* Is anything happening that simulating would change?  DMA in flight, or BSY
+ * asserted - which covers arbitration, selection and every phase of a
+ * connection, because BSY is held for all of it. */
+static bool sun3_si_busy(Sun3SiState *s)
+{
+#define CSB_BSY 0x40
+    return s->dma_running || (si_read(s, 4) & CSB_BSY);
+}
+
+/* Bring the core up to virtual time, but only while it has work to do. */
+static void sun3_si_catch_up(Sun3SiState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    int64_t delta = now - s->last_ns;
+
+    s->last_ns = now;
+    if (!s->use_rtl || delta <= 0 || !sun3_si_busy(s)) {
+        return;
+    }
+    if (delta > MAX_CATCH_UP_NS) {
+        delta = MAX_CATCH_UP_NS;
+        s->clamped++;
+    }
+    si_run_ns(s, delta);
+}
+
+/*
+ * Let the chip finish having its say.
+ *
+ * A transfer ends when the last byte moves, but the chip raises its interrupt
+ * a little after that - it has to see the target leave the phase first.  If
+ * the line is only reconsidered on the next pacing tick, the guest waits up
+ * to TIMER_PERIOD_NS of *its* time for an interrupt about a transfer that,
+ * measured on its own clock, took four microseconds: the whole 8 kilobytes
+ * costs about 4 us of guest time and 34 ms of the core's, because the core
+ * runs inside one blocking access during which the guest executes nothing.
+ * An interrupt a hundred transfer-lengths late is what a driver calls lost.
+ *
+ * So step the core on a little at the end of a transfer until it asserts.
+ * The bound is generous compared with the microsecond or so it really takes,
+ * and costs nothing when the chip has already done it.
+ */
+#define SETTLE_STEP_NS  1000
+#define SETTLE_MAX_NS   (200 * 1000)
+
+static void sun3_si_settle(Sun3SiState *s)
+{
+    uint64_t waited = 0;
+
+    if (!s->use_rtl) {
+        return;         /* the software chip has already had its say */
+    }
+    while (!si_irq(s) && waited < SETTLE_MAX_NS) {
+        si_run_ns(s, SETTLE_STEP_NS);
+        waited += SETTLE_STEP_NS;
+    }
+}
+
 /*
  * Move whatever the chip is asking for.
  *
  * A real UDC is woken by DREQ and takes the bus; here the pump is called after
- * every register access and from the chip's own DRQ and interrupt pins, which
- * comes to the same thing because nothing else can happen in between.  End of
- * Process is asserted across the last acknowledge, which is what sets END OF
- * DMA in the chip.
+ * every register access and from a timer, which comes to the same thing
+ * because nothing else can happen in between.  End of Process is asserted
+ * across the last acknowledge, which is what sets END OF DMA in the chip.
  */
 static void sun3_si_pump(Sun3SiState *s)
 {
+    uint64_t waited = 0;
+
     if (!s->dma_running || s->pumping) {
         /* Re-entered from the DRQ callback, which the software chip raises
          * from inside dack_read - the byte after this one is already being
@@ -199,7 +440,7 @@ static void sun3_si_pump(Sun3SiState *s)
         bool last = (s->fifo_count == 1);
         uint8_t byte;
 
-        if (!ncr5380_drq(&s->chip)) {
+        while (!si_drq(s)) {
             /* The chip has nothing to hand over yet.  The transfer is over
              * when the target leaves the phase the chip was set up for: the
              * chip stops recognising REQ, no further request will come, and
@@ -232,8 +473,7 @@ static void sun3_si_pump(Sun3SiState *s)
              * the mismatch as the end only after that.
              */
 #define BSR_PHASE_MATCH 0x08
-            bool matched =
-                (ncr5380_reg_read(&s->chip, 5) & BSR_PHASE_MATCH) != 0;
+            bool matched = (si_read(s, 5) & BSR_PHASE_MATCH) != 0;
             /* Both signals, and neither alone.  The interrupt on its own is a
              * latch left over from the command before.  The phase on its own
              * is momentary - it is false between the chip being armed and the
@@ -241,26 +481,41 @@ static void sun3_si_pump(Sun3SiState *s)
              * during a transfer, which ended the PROM's boot block read early
              * and got "scsi: dma never completed".  Together, after the chip
              * has asked at least once, they mean the target has moved on. */
-            if (s->saw_drq && !matched && ncr5380_irq(&s->chip)) {
+            if (s->saw_drq && !matched && si_irq(s)) {
                 s->dma_running = false;
                 s->csr &= ~SI_CSR_DMA_ACTIVE;
                 trace_sun3_si_dma_done(s->fifo_count, s->csr, s->head);
+                sun3_si_settle(s);
+                s->pumping = false;
+                return;
             }
-
-            /* Either way there is nothing to wait for here.  The chip has no
-             * time in it, so if it is not asking now it is waiting on
-             * something only the block layer can finish - and it will say so
-             * by raising DRQ, which brings us straight back.  Spinning would
-             * be worse than pointless: scsi_req_enqueue on a real disk
-             * completes on the AIO path, which cannot run while this function
-             * holds the thread inside an MMIO handler. */
-            s->pumping = false;
-            return;
+            if (!s->use_rtl) {
+                /* Nothing to spin for.  The software chip has no time in it,
+                 * so if it is not asking now it is waiting on something that
+                 * only the block layer can finish - and it will say so by
+                 * raising DRQ, which brings us straight back here.  Spinning
+                 * would be worse than pointless: scsi_req_enqueue on a real
+                 * disk completes on the AIO path, which cannot run while this
+                 * function holds the thread inside an MMIO handler. */
+                s->pumping = false;
+                return;
+            }
+            if (waited >= DRQ_WAIT_NS) {
+                /* Nothing asked for in a long time.  Give the emulator back
+                 * its thread; the pump is re-entered on the next register
+                 * access, and a transfer that has not started yet is waiting
+                 * for the driver to finish setting the chip up. */
+                s->pumping = false;
+                return;
+            }
+            si_run_ns(s, DRQ_STEP_NS);
